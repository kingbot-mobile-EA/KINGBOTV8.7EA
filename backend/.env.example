# KingBot V8.7 Platform — Backend Environment Variables
# Copy this file to `.env` and fill in the values. For Render, add these in the
# Environment tab of your web service.

# ---- Server ----
PORT=8080
NODE_ENV=production
# Comma-separated list of allowed origins (your GitHub Pages URL + dev)
CORS_ORIGIN=https://YOUR_GITHUB_USERNAME.github.io,http://localhost:8080,http://127.0.0.1:8080

# ---- Auth / Security ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Email verification (SMTP). Use a provider like Resend, SendGrid, Mailgun or SMTP.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-resend-api-key
SMTP_FROM=KingBot <noreply@yourdomain.com>
# If false, verification links are logged to console instead of emailed (dev mode)
EMAIL_ENABLED=false

# SMS / Phone OTP (Twilio or any SMS gateway). If false, OTP is logged to console.
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM=+10000000000

# ---- Subscriptions / Payments ----
# Stripe-style provider. Mock mode works without keys (generates license keys).
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYMENT_CURRENCY=usd

# ---- EA MT5 Bridge ----
# The bridge lets mobile users connect their MT5 terminal WITHOUT a PC.
# Uses the KingBot HTTP bridge protocol. In production, point this at your
# hosted MT5 bridge / VPS. If MOCK_EA=true the backend simulates live data.
EA_BRIDGE_URL=http://localhost:3001
EA_BRIDGE_TOKEN=change-me
MOCK_EA=true

# ---- AI Support ----
# OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, local LLM). Leave blank
# to use a built-in rule-based assistant trained on the KingBot guide.
AI_PROVIDER=rule
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=600

# ---- Storage ----
# Data directory for the lightweight JSON file store (Render ephemeral disk).
# For production persistence, swap the file store for Postgres (see README).
DATA_DIR=./data
